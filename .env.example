# OpenAI: mantenha a chave real somente no arquivo local .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Limites do servico de controle de uso da IA.
# As janelas de hora/dia usam timestamps UTC.
IA_LIMITE_USUARIO_HORA=10
IA_LIMITE_USUARIO_DIA=30
IA_LIMITE_GLOBAL_DIA=100
IA_MAX_CONCORRENCIA_USUARIO=1
IA_MAX_CONCORRENCIA_GLOBAL=2
IA_RESERVA_TTL_MINUTOS=15
